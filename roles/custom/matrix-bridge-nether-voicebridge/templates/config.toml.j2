# Nether Voice Bridge configuration
# Generated by Ansible — do not edit directly.
# To customize, use matrix_nether_voicebridge_configuration_extension_toml.

[puppets]
tokens = [
{% for token in matrix_nether_voicebridge_puppet_tokens %}
  "{{ token }}",
{% endfor %}
]
nickname_prefix = "{{ matrix_nether_voicebridge_puppet_nickname_prefix }}"

{% for bridge in matrix_nether_voicebridge_bridges %}
[[bridge]]
name = "{{ bridge.name }}"

[bridge.discord]
guild_id = "{{ bridge.discord_guild_id }}"
channel_id = "{{ bridge.discord_channel_id }}"

[bridge.matrix]
homeserver_url = "{{ matrix_nether_voicebridge_homeserver_address }}"
matrix_domain = "{{ matrix_nether_voicebridge_homeserver_domain }}"
room_id = "{{ bridge.matrix_room_id }}"
sender_localpart = "{{ matrix_nether_voicebridge_sender_localpart }}"
appservice_id = "{{ matrix_nether_voicebridge_appservice_id }}"
appservice_token = "{{ matrix_nether_voicebridge_appservice_token }}"
{% if matrix_nether_voicebridge_bot_display_name | length > 0 %}
bot_display_name = "{{ matrix_nether_voicebridge_bot_display_name }}"
{% endif %}

[bridge.livekit]
{% for key, value in (bridge.livekit | default({})).items() %}
{{ key }} = {{ value | to_json }}
{% endfor %}

{% endfor %}
{% if matrix_nether_voicebridge_configuration_extension_toml | length > 0 %}
{{ matrix_nether_voicebridge_configuration_extension_toml }}
{% endif %}
